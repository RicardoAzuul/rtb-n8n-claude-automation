# Copy this file to .env and fill in the values:
#   cp example.env .env && chmod 600 .env
# .env is git-ignored. Never commit real values to this file.

# Required: n8n API key (n8n UI > Settings > n8n API)
N8N_API_KEY=your-n8n-api-key-here

# Optional: defaults shown
N8N_BASE_URL=http://localhost:5678
N8N_API_PREFIX=/api/v1

# Optional: container name if n8n runs in Docker (used by cli-execute)
# N8N_DOCKER_CONTAINER=n8n
